# ──────────────────────────────────────────────────────────────
# NNOUSS.LOG Frontend - 환경변수 예시
# 실제 값은 .env(.local) 에 채워 넣으세요. .env* 는 git 에 커밋되지 않습니다.
# 모든 변수는 NEXT_PUBLIC_ 접두사라 빌드 시 클라이언트 번들에 인라인됩니다.
# (= 브라우저에 공개되는 값이므로 진짜 비밀키는 절대 넣지 마세요)
# ──────────────────────────────────────────────────────────────

# 백엔드 API 서버 주소 (별도 NestJS 서버)
NEXT_PUBLIC_API_BASE='http://localhost:8000'

# 공개 사이트 URL (sitemap / robots / Open Graph 절대경로 생성에 사용)
NEXT_PUBLIC_SITE_URL='http://localhost:3000'

# 검색엔진 소유권 인증 토큰 (선택)
# 미설정 시 해당 <meta> 태그를 출력하지 않습니다.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=''
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=''
